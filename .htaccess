# patologicos.com — reglas de servidor (Apache / Hostinger)

# --------------------------------------------------------------------------
# 1) BLINDAJE de datos y fuentes. data/ contiene PII de los leads (correo,
#    WhatsApp): jamás debe ser legible por web. _design/ son las fuentes del
#    compilador, no contenido publicable. Única excepción: data/catalogo.json
#    es el catálogo público POND (mismo patrón que .gitignore y el deploy).
# --------------------------------------------------------------------------
RedirectMatch 404 ^/data/?$
RedirectMatch 404 ^/data/(?!catalogo\.json$)
RedirectMatch 404 ^/secrets(/|$)
RedirectMatch 404 ^/_design(/|$)
RedirectMatch 404 ^/blog/_(src|pending|rejected)(/|$)

<FilesMatch "\.(jsonl|md|dc\.html|bak)$">
  Require all denied
</FilesMatch>

# --------------------------------------------------------------------------
# 2) CACHÉ. Lección ya pagada: el edge de Hostinger (hcdn) cachea el HTML por
#    DÍAS si el origen no manda Cache-Control, y la raíz se queda "stale" tras
#    cada deploy. El HTML se revalida siempre; los estáticos con hash sí se
#    cachean fuerte.
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --------------------------------------------------------------------------
# 3) MIGRACIONES SEO. Cada contenido público tiene un solo canonical.
#    Las URLs históricas conservan su autoridad con 301; nunca se dejan dos
#    copias indexables del mismo artículo.
# --------------------------------------------------------------------------
RedirectMatch 301 ^/blog/tu-negocio-sera-invisible\.html$ https://patologicos.com/invisible/

# --------------------------------------------------------------------------
# 4) Canónico: una sola casa. Sin esto el sitio vive en dos hostnames y las
#    señales de ranking se parten (el mismo problema detectado en fanatia.com).
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.patologicos\.com$ [NC]
  RewriteRule ^(.*)$ https://patologicos.com/$1 [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# 5) La preview de Lumin ya no vive aquí. El sitio tiene su propio dominio
#    (www.velasaromaticas.com.mx) desde el cutover; dejar una copia navegable
#    en patologicos.com parte las señales y muestra precios que envejecen.
#    El sandbox sigue sirviendo para el resto de previews.
# --------------------------------------------------------------------------
RedirectMatch 301 ^/sandbox/velaslumin/?(.*)$ https://www.velasaromaticas.com.mx/$1

ErrorDocument 404 /index.html
